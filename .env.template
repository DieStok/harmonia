# Harmonia Environment Configuration
# Copy this file and add your actual API keys
# Keep this file secure and DO NOT commit to git!

# ============================================
# LLM API Keys
# ============================================

# OpenAI API Key (for GPT-4, etc.)
OPENAI_API_KEY=your_openai_api_key_here

# OpenRouter API Key (alternative LLM provider)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Anthropic API Key (for Claude models)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================
# Jupyter/Beaker Configuration
# ============================================

# Jupyter authentication token (default provided)
JUPYTER_TOKEN=89f73481102c46c0bc13b2998f9a4fce

# Enable debug mode (true/false)
DEBUG=1

# Enable user prompts
ENABLE_USER_PROMPT=true

# Enable checkpoints for rollback
ENABLE_CHECKPOINTS=true

# ============================================
# Optional: LLM Provider Configuration
# ============================================

# Which LLM provider to use (openai, openrouter, anthropic, ollama)
# LLM_SERVICE_PROVIDER=openai

# Which model to use
# LLM_SERVICE_MODEL=gpt-4o

# Path to Python packages
PYTHONPATH=/jupyter

# SSL certificate file (leave empty to disable)
SSL_CERT_FILE=