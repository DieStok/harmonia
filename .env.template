# =============================================================================
# Harmonia Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# Keep this file secure and DO NOT commit to git!

# -----------------------------------------------------------------------------
# API Keys (set the one(s) you plan to use)
# -----------------------------------------------------------------------------

# OpenAI API Key (for GPT-4, GPT-4o, etc.)
OPENAI_API_KEY=your_openai_api_key_here

# OpenRouter API Key (access to multiple providers via single API)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Anthropic API Key (for Claude models)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Groq API Key (for fast inference)
GROQ_API_KEY=your_groq_api_key_here

# Google API Key (for Gemini models)
GOOGLE_API_KEY=your_google_api_key_here

# -----------------------------------------------------------------------------
# LLM Provider Configuration
# -----------------------------------------------------------------------------

# Provider options: openai, openrouter, anthropic, ollama, azure, bedrock, gemini, groq
LLM_SERVICE_PROVIDER=openai

# Model name (provider-specific)
# Examples:
#   openai: gpt-4o, gpt-4-turbo, gpt-3.5-turbo
#   openrouter: anthropic/claude-3.5-sonnet, meta-llama/llama-3.1-70b-instruct
#   anthropic: claude-3-5-sonnet-20241022, claude-3-opus-20240229
#   ollama: llama3.1:70b, mistral, codellama
#   groq: llama-3.1-70b-versatile, mixtral-8x7b-32768
LLM_SERVICE_MODEL=gpt-4o

# Optional: Custom base URL (for Ollama, proxies, or self-hosted models)
# LLM_BASE_URL=http://localhost:11434

# Optional: Temperature (0.0 = deterministic, 1.0 = creative)
# LLM_TEMPERATURE=0.0

# Optional: Max tokens for response
# LLM_MAX_TOKENS=4096

# -----------------------------------------------------------------------------
# Jupyter/Beaker Settings
# -----------------------------------------------------------------------------

# Jupyter authentication token
JUPYTER_TOKEN=89f73481102c46c0bc13b2998f9a4fce

# Enable debug mode
DEBUG=1

# Enable user prompts (allows agent to ask user questions)
ENABLE_USER_PROMPT=true

# Enable checkpoints for rollback
ENABLE_CHECKPOINTS=true

# -----------------------------------------------------------------------------
# System Settings
# -----------------------------------------------------------------------------

# Python path inside container
PYTHONPATH=/jupyter

# SSL certificate path (HPC environments may need this)
# SSL_CERT_FILE=/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem

# Optional: Path to YAML config file (for advanced configuration)
# HARMONIA_CONFIG=/jupyter/config.yaml
